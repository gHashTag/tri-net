# Board synthesis of the Wukong GF-T ALU self-check top (yosys, internal CFGMCLK clock).
#   yosys fpga/gft/synth_gft_alu_wukong.ys
read_verilog fpga/gft/gft_mul.v fpga/gft/gft_add.v fpga/gft/gft_sub.v fpga/gft/gft_alu.v fpga/gft/gft_alu_selfcheck.v fpga/gft/gft_alu_wukong.v
synth_xilinx -flatten -top gft_alu_wukong
stat
