# Reproducible open-source synthesis of the GF-T multiplier (yosys, NO Vivado).
#   yosys fpga/gft/synth_gft_mul.ys
# Targets the Xilinx 7-series primitives used by the AX7203 openXC7 flow
# (yosys synth_xilinx -> nextpnr-xilinx). Emits a utilization stat report.
read_verilog fpga/gft/gft_mul.v
hierarchy -top gft_mul
synth_xilinx -flatten
stat
