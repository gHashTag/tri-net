#define DEFENDER_HONEST 1
#define DEFENDER_LIED 2
#define RESOLVE_TIMEOUT 27
#define CH_GFT16_ET 4
#define CH_BASE_WINDOW 64
#define CH_WINDOW_PER_TRIT 16
