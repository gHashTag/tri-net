/* -------------------------------------------------------
   Function implementations
   ------------------------------------------------------- */

bool is_valid_challenge(uint32_t defender_seal, uint32_t challenger_seal) {
    return (defender_seal != challenger_seal);
}

uint32_t resolve(uint32_t defender_seal, uint32_t truth_seal) {
    if ((defender_seal == truth_seal)) {
        return DEFENDER_HONEST;
    } else {
        return DEFENDER_LIED;
    }
}

uint32_t defender_bond_after(uint32_t verdict, uint32_t defender_bond, uint32_t challenger_bond) {
    if ((verdict == DEFENDER_HONEST)) {
        return (defender_bond + challenger_bond);
    } else {
        return 0;
    }
}

uint32_t challenger_bond_after(uint32_t verdict, uint32_t defender_bond, uint32_t challenger_bond) {
    if ((verdict == DEFENDER_HONEST)) {
        return 0;
    } else {
        return (challenger_bond + defender_bond);
    }
}

bool challenge_admissible(uint32_t now_epoch, uint32_t receipt_epoch, uint32_t window) {
    if ((now_epoch < receipt_epoch)) {
        return (now_epoch > now_epoch);
    }
    return ((now_epoch - receipt_epoch) < window);
}

bool dispute_expired(uint32_t opened_epoch, uint32_t now_epoch) {
    if ((now_epoch < opened_epoch)) {
        return (opened_epoch < opened_epoch);
    }
    return ((now_epoch - opened_epoch) > RESOLVE_TIMEOUT);
}

uint32_t expired_verdict(void) {
    return DEFENDER_HONEST;
}

uint32_t challenge_window_for_rung(uint32_t gf_et) {
    if ((gf_et <= CH_GFT16_ET)) {
        return CH_BASE_WINDOW;
    } else {
        return (CH_BASE_WINDOW + ((gf_et - CH_GFT16_ET) * CH_WINDOW_PER_TRIT));
    }
}

bool challenge_admissible_rung(uint32_t now_epoch, uint32_t receipt_epoch, uint32_t gf_et) {
    return challenge_admissible(now_epoch, receipt_epoch, challenge_window_for_rung(gf_et));
}

uint32_t witness_majority(uint32_t s0, uint32_t s1, uint32_t s2) {
    if ((s0 == s1)) {
        return s0;
    }
    if ((s0 == s2)) {
        return s0;
    }
    if ((s1 == s2)) {
        return s1;
    }
    return 0;
}

uint32_t witness_verdict(uint32_t defender_seal, uint32_t s0, uint32_t s1, uint32_t s2) {
    uint32_t truth = witness_majority(s0, s1, s2);
    if ((truth == 0)) {
        return VERDICT_NONE;
    }
    return resolve(defender_seal, truth);
}

bool witness_is_majority(uint32_t seal, uint32_t majority) {
    return ((majority != 0) && (seal == majority));
}

uint32_t majority_count_3(uint32_t s0, uint32_t s1, uint32_t s2, uint32_t majority) {
    uint32_t c0 = if_seal(s0, majority);
    uint32_t c1 = if_seal(s1, majority);
    uint32_t c2 = if_seal(s2, majority);
    return ((c0 + c1) + c2);
}

uint32_t if_seal(uint32_t seal, uint32_t majority) {
    if (witness_is_majority(seal, majority)) {
        return 1;
    } else {
        return 0;
    }
}

uint32_t minority_pot_3(uint32_t s0, uint32_t s1, uint32_t s2, uint32_t majority, uint32_t stake) {
    return ((3 - majority_count_3(s0, s1, s2, majority)) * stake);
}

uint32_t witness_payout(uint32_t voted, uint32_t s0, uint32_t s1, uint32_t s2, uint32_t stake) {
    uint32_t majority = witness_majority(s0, s1, s2);
    if ((majority == 0)) {
        return stake;
    }
    if (witness_is_majority(voted, majority)) {
        uint32_t pot = minority_pot_3(s0, s1, s2, majority, stake);
        return (stake + (pot / majority_count_3(s0, s1, s2, majority)));
    }
    return 0;
}

bool dispute_slots_ok(uint32_t open_count) {
    return (open_count < MAX_OPEN_DISPUTES);
}

uint32_t risk_after_open(uint32_t risk, uint32_t reward) {
    uint32_t sum = (risk + reward);
    if ((sum < risk)) {
        return 0xFFFFFFFF;
    } else {
        return sum;
    }
}

uint32_t risk_after_close(uint32_t risk, uint32_t reward) {
    if ((reward >= risk)) {
        return 0;
    } else {
        return (risk - reward);
    }
}

uint32_t dispute_required_bond(uint32_t outstanding, uint32_t min_bps) {
    uint64_t need = (((uint64_t)(outstanding)) * ((uint64_t)(min_bps)));
    return ((uint32_t)((need / ((uint64_t)(CH_BPS_UNIT)))));
}

bool may_open_dispute(uint32_t open_count, uint32_t risk, uint32_t reward, uint32_t bond, uint32_t min_bps) {
    if ((dispute_slots_ok(open_count) == false)) {
        return false;
    }
    return (bond >= dispute_required_bond(risk_after_open(risk, reward), min_bps));
}

uint32_t dispute_rung_min_bps(uint32_t min_bps, uint32_t gf_et) {
    if ((gf_et <= CH_GFT16_ET)) {
        return min_bps;
    } else {
        return (min_bps + ((gf_et - CH_GFT16_ET) * CH_BOND_BPS_PER_TRIT));
    }
}

bool may_open_dispute_rung(uint32_t open_count, uint32_t risk, uint32_t reward, uint32_t bond, uint32_t min_bps, uint32_t gf_et) {
    return may_open_dispute(open_count, risk, reward, bond, dispute_rung_min_bps(min_bps, gf_et));
}

/* -------------------------------------------------------
   Tests
   ------------------------------------------------------- */

void test_challenge_needs_disagreement(void) {
    t27_assert((is_valid_challenge(0x6EAC3F90, 0xDEADBEEF) == true), "different seals -> valid");
    t27_assert((is_valid_challenge(0x6EAC3F90, 0x6EAC3F90) == false), "same seal -> no dispute");
}

void test_honest_defender_wins(void) {
    uint64_t v = resolve(0x6EAC3F90, 0x6EAC3F90);
    (void)v;
    t27_assert((v == DEFENDER_HONEST), "defender honest");
}

void test_lying_defender_slashed(void) {
    uint64_t v = resolve(0xBADBAD00, 0x6EAC3F90);
    (void)v;
    t27_assert((v == DEFENDER_LIED), "defender lied");
}

void test_bonds_honest_defender(void) {
    uint64_t da = defender_bond_after(DEFENDER_HONEST, 100, 100);
    (void)da;
    uint64_t ca = challenger_bond_after(DEFENDER_HONEST, 100, 100);
    (void)ca;
    t27_assert((da == 200), "defender gains challenger's bond");
    t27_assert((ca == 0), "challenger loses its bond");
    t27_assert(((da + ca) == 200), "total bond conserved");
}

void test_bonds_lying_defender(void) {
    uint64_t da = defender_bond_after(DEFENDER_LIED, 100, 100);
    (void)da;
    uint64_t ca = challenger_bond_after(DEFENDER_LIED, 100, 100);
    (void)ca;
    t27_assert((da == 0), "defender is slashed");
    t27_assert((ca == 200), "challenger gains defender's bond");
    t27_assert(((da + ca) == 200), "total bond conserved");
}

void test_griefing_unprofitable(void) {
    uint64_t v = resolve(0x11223344, 0x11223344);
    (void)v;
    uint64_t ca = challenger_bond_after(v, 100, 100);
    (void)ca;
    t27_assert((ca < 100), "frivolous challenger ends with less than it posted");
}

void test_witness_quorum(void) {
    uint64_t v_unanimous = witness_verdict(0xAAAA, 0xAAAA, 0xAAAA, 0xAAAA);
    (void)v_unanimous;
    uint64_t v_one_liar = witness_verdict(0xAAAA, 0xAAAA, 0xDEAD, 0xAAAA);
    (void)v_one_liar;
    uint64_t v_frame = witness_verdict(0xAAAA, 0xBBBB, 0xAAAA, 0xAAAA);
    (void)v_frame;
    uint64_t v_caught = witness_verdict(0xBAD0, 0xAAAA, 0xAAAA, 0xDEAD);
    (void)v_caught;
    uint64_t v_none = witness_verdict(0xAAAA, 0x1111, 0x2222, 0x3333);
    (void)v_none;
    t27_assert((v_unanimous == DEFENDER_HONEST), "unanimous truth clears the defender");
    t27_assert((v_one_liar == DEFENDER_HONEST), "one lying witness cannot flip an honest majority");
    t27_assert((v_frame == DEFENDER_HONEST), "one framing witness cannot slash an honest defender");
    t27_assert((v_caught == DEFENDER_LIED), "a real lie is caught by the majority");
    t27_assert((v_none == VERDICT_NONE), "no quorum -> no verdict, dispute stays open");
}

void test_witness_economics(void) {
    uint64_t u = witness_payout(0xAAAA, 0xAAAA, 0xAAAA, 0xAAAA, 100);
    (void)u;
    uint64_t m = witness_payout(0xAAAA, 0xAAAA, 0xAAAA, 0xDEAD, 100);
    (void)m;
    uint64_t l = witness_payout(0xDEAD, 0xAAAA, 0xAAAA, 0xDEAD, 100);
    (void)l;
    uint64_t n = witness_payout(0x1111, 0x1111, 0x2222, 0x3333, 100);
    (void)n;
    t27_assert((u == 100), "unanimous round: stake back, no free reward");
    t27_assert((m == 150), "majority of two splits the one forfeited stake");
    t27_assert((l == 0), "the dissenter forfeits");
    t27_assert((n == 100), "no quorum refunds everyone");
    t27_assert((((m + m) + l) == 300), "2-1 round conserves the three stakes");
}

void test_rung_aware_admission(void) {
    uint64_t p4 = dispute_rung_min_bps(2000, 4);
    (void)p4;
    uint64_t p9 = dispute_rung_min_bps(2000, 9);
    (void)p9;
    uint64_t f0 = may_open_dispute_rung(0, 400, 100, 100, 2000, 4);
    (void)f0;
    uint64_t w0 = may_open_dispute_rung(0, 400, 100, 100, 2000, 9);
    (void)w0;
    uint64_t w1 = may_open_dispute_rung(0, 400, 100, 225, 2000, 9);
    (void)w1;
    t27_assert((p4 == 2000), "at the flagship the base premium applies");
    t27_assert((p9 == 4500), "Et9 adds 2500 bps");
    t27_assert((f0 == true), "bond 100 covers 500 at 20% on the flagship");
    t27_assert((w0 == false), "the SAME bond fails the SAME dispute at Et9 (needs 45%)");
    t27_assert((w1 == true), "225 covers 500 at 45% on the wide rung");
}

void test_dispute_slots_and_risk_ledger(void) {
    uint64_t s0 = dispute_slots_ok(0);
    (void)s0;
    uint64_t s2 = dispute_slots_ok(2);
    (void)s2;
    uint64_t s3 = dispute_slots_ok(3);
    (void)s3;
    uint64_t r1 = risk_after_open(100, 40);
    (void)r1;
    uint64_t r0 = risk_after_close(140, 40);
    (void)r0;
    uint64_t ru = risk_after_close(30, 40);
    (void)ru;
    uint64_t rs = risk_after_open(0xFFFFFFF0, 0x100);
    (void)rs;
    t27_assert((s0 == true), "empty ledger has slots");
    t27_assert((s2 == true), "slot 3 of 3 may open");
    t27_assert((s3 == false), "the cap is exact at MAX_OPEN_DISPUTES");
    t27_assert((r1 == 140), "open adds the reward at risk");
    t27_assert((r0 == 100), "close returns to the baseline");
    t27_assert((ru == 0), "close floors at zero, never wraps");
    t27_assert((rs == 0xFFFFFFFF), "an overflowing open saturates");
}

void test_dispute_admission_gate(void) {
    uint64_t a0 = may_open_dispute(0, 0, 400, 100, 2000);
    (void)a0;
    uint64_t a1 = may_open_dispute(0, 0, 600, 100, 2000);
    (void)a1;
    uint64_t a2 = may_open_dispute(3, 0, 10, 1000000, 2000);
    (void)a2;
    uint64_t a3 = may_open_dispute(1, 400, 100, 100, 2000);
    (void)a3;
    uint64_t a4 = may_open_dispute(1, 450, 100, 100, 2000);
    (void)a4;
    t27_assert((a0 == true), "bond 100 covers 20% of 400");
    t27_assert((a1 == false), "bond 100 cannot cover 20% of 600");
    t27_assert((a2 == false), "no slot, no dispute, whatever the bond");
    t27_assert((a3 == true), "risk 400 + 100 = 500 requires exactly the full bond -- exact cover admits");
    t27_assert((a4 == false), "risk 450 + 100 = 550 requires 110 > bond 100 -- rejected");
}

void test_rung_window_edges(void) {
    uint64_t f0 = challenge_admissible_rung(1063, 1000, 4);
    (void)f0;
    uint64_t f1 = challenge_admissible_rung(1064, 1000, 4);
    (void)f1;
    uint64_t w0 = challenge_admissible_rung(1064, 1000, 9);
    (void)w0;
    uint64_t w1 = challenge_admissible_rung(1143, 1000, 9);
    (void)w1;
    uint64_t w2 = challenge_admissible_rung(1144, 1000, 9);
    (void)w2;
    t27_assert((f0 == true), "flagship: epoch 63 of 64 is challengeable");
    t27_assert((f1 == false), "flagship: the finalization epoch admits nothing");
    t27_assert((w0 == true), "GF-T64 (Et9) is still challengeable where GF-T16 finalized");
    t27_assert((w1 == true), "GF-T64: epoch 143 of 144 is challengeable");
    t27_assert((w2 == false), "GF-T64: its own finalization epoch admits nothing");
}

void test_window_edges(void) {
    uint64_t a0 = challenge_admissible(100, 100, 8);
    (void)a0;
    uint64_t a1 = challenge_admissible(107, 100, 8);
    (void)a1;
    uint64_t a2 = challenge_admissible(108, 100, 8);
    (void)a2;
    uint64_t a3 = challenge_admissible(99, 100, 8);
    (void)a3;
    t27_assert((a0 == true), "fresh receipt is challengeable");
    t27_assert((a1 == true), "last in-window epoch (window - 1) is challengeable");
    t27_assert((a2 == false), "the finalization epoch itself admits no challenge");
    t27_assert((a3 == false), "a backwards clock admits nothing");
}

void test_expiry_edges(void) {
    uint64_t e0 = dispute_expired(50, 77);
    (void)e0;
    uint64_t e1 = dispute_expired(50, 78);
    (void)e1;
    uint64_t e2 = dispute_expired(50, 49);
    (void)e2;
    t27_assert((e0 == false), "at the timeout the dispute is still live");
    t27_assert((e1 == true), "one epoch past the timeout it expires");
    t27_assert((e2 == false), "a backwards clock never expires a dispute");
}

void test_expired_dispute_settles_for_defender(void) {
    uint64_t v = expired_verdict();
    (void)v;
    uint64_t da = defender_bond_after(v, 150, 100);
    (void)da;
    uint64_t ca = challenger_bond_after(v, 150, 100);
    (void)ca;
    t27_assert((v == DEFENDER_HONEST), "no proof -> no slash");
    t27_assert((da == 250), "defender keeps both bonds");
    t27_assert((ca == 0), "the non-resolving challenger forfeits");
    t27_assert(((da + ca) == 250), "total bond conserved on the expiry path");
}


