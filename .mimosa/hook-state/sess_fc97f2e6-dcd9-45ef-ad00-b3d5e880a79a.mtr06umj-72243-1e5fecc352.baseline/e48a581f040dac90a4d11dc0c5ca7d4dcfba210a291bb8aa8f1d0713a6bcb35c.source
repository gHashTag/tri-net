    uint32_t available_cpu = (100 - get_cpu_usage(state));
    uint32_t available_memory = (100 - get_memory_usage(state));
    if (((available_cpu >= required_cpu) && (available_memory >= required_memory))) {
        return 1;
    } else {
        return 0;
    }
}

