    uint32_t memory = get_memory_usage(state);
    uint32_t tasks = get_task_count(state);
    uint32_t available = get_available_resources(state);
    cpu = (cpu + cpu_delta);
    memory = (memory + memory_delta);
    tasks = (tasks + task_delta);
    if ((cpu > 100)) {
        cpu = 100;
    }
    if ((memory > 100)) {
        memory = 100;
    }
    available = (100 - ((cpu + memory) / 2));
    return create_resource_state(cpu, memory, tasks, available);
}

