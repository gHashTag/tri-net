uint32_t create_critical_path(uint32_t delay, uint32_t stages, uint32_t slack) {
    return ((((delay & 0xFFFF) << 16) | ((stages & 0xFF) << 8)) | (slack & 0xFF));
}

uint32_t extract_delay(uint32_t path) {
    return ((path >> 16) & 0xFFFF);
}

uint32_t extract_stages(uint32_t path) {
    return ((path >> 8) & 0xFF);
}

uint32_t extract_slack(uint32_t path) {
    return (path & 0xFF);
}

uint32_t grade_timing(uint32_t slack) {
    if ((slack > 0x7FFFFFFF)) {
        return TIMING_FAIL;
    } else if ((slack >= 100)) {
        return TIMING_PASS;
    } else {
        return TIMING_MARGINAL;
    }
}

uint32_t calculate_pipeline_stages(uint32_t delay, uint32_t target_freq) {
    if ((target_freq == 0)) {
        return MAX_PIPELINE;
    }
    if (((1000 / target_freq) == 0)) {
        return MAX_PIPELINE;
    }
    if (((delay / (1000 / target_freq)) < MIN_PIPELINE)) {
        return MIN_PIPELINE;
    }
    if (((delay / (1000 / target_freq)) > MAX_PIPELINE)) {
        return MAX_PIPELINE;
    }
    return (delay / (1000 / target_freq));
}

bool retiming_needed(uint32_t current_slack, uint32_t threshold) {
    return (current_slack < threshold);
}

bool balance_registers(uint32_t stage_delay, uint32_t target_period) {
    return (stage_delay > (target_period * 2));
}

uint32_t compare_critical_paths(uint32_t path1, uint32_t path2) {
    if ((extract_delay(path1) > extract_delay(path2))) {
        return path1;
    } else {
        return path2;
    }
}

uint32_t create_timing_report(uint32_t grade, uint32_t max_freq, uint32_t critical_paths) {
    return ((((grade & 0x3) << 30) | ((max_freq & 0x3FF) << 20)) | (critical_paths & 0xFFFFF));
}

uint32_t extract_grade(uint32_t report) {
    return ((report >> 30) & 0x3);
}

uint32_t extract_max_freq(uint32_t report) {
    return ((report >> 20) & 0x3FF);
}

uint32_t extract_critical_paths(uint32_t report) {
    return (report & 0xFFFFF);
}

bool timing_closure_achieved(uint32_t report, uint32_t target_freq) {
    return ((extract_grade(report) == TIMING_PASS) && (extract_max_freq(report) >= target_freq));
}

