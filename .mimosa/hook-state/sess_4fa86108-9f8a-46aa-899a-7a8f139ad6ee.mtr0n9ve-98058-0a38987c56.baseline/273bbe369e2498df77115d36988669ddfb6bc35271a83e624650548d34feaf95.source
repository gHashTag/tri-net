#ifndef TRICOMPUTEBOND_H
#define TRICOMPUTEBOND_H

/* -------------------------------------------------------
   Constants
   ------------------------------------------------------- */

#define ST_FREE 0
#define ST_LOCKED 1
#define ST_RELEASED 2
#define ST_SLASHED 3
#define BOND_BPS_UNIT 10000
#define GFT16_ET 4
#define BOND_BPS_PER_TRIT 500

/* -------------------------------------------------------
   Function prototypes
   ------------------------------------------------------- */

bool can_post(uint32_t balance, uint32_t amount);
uint32_t balance_after_post(uint32_t balance, uint32_t amount);
uint32_t locked_amount(uint32_t balance, uint32_t amount);
uint32_t bond_state_after(uint32_t outcome);
uint32_t balance_after_resolve(uint32_t balance, uint32_t bond, uint32_t outcome);
uint32_t required_bond(uint32_t outstanding, uint32_t min_bps);
bool bond_covers(uint32_t bond, uint32_t outstanding, uint32_t min_bps);
uint32_t rung_min_bps(uint32_t min_bps, uint32_t gf_et);
uint32_t required_bond_rung(uint32_t outstanding, uint32_t min_bps, uint32_t gf_et);
bool bond_covers_rung(uint32_t bond, uint32_t outstanding, uint32_t min_bps, uint32_t gf_et);

/* -------------------------------------------------------
   Function implementations
   ------------------------------------------------------- */

bool can_post(uint32_t balance, uint32_t amount) {
    return (amount <= balance);
}

uint32_t balance_after_post(uint32_t balance, uint32_t amount) {
    if ((amount <= balance)) {
        return (balance - amount);
    } else {
        return balance;
    }
}

uint32_t locked_amount(uint32_t balance, uint32_t amount) {
    if ((amount <= balance)) {
        return amount;
    } else {
        return 0;
    }
}

uint32_t bond_state_after(uint32_t outcome) {
    if ((outcome == 0)) {
        return ST_RELEASED;
    } else if ((outcome == 1)) {
        return ST_SLASHED;
    } else {
        return ST_LOCKED;
    }
}

uint32_t balance_after_resolve(uint32_t balance, uint32_t bond, uint32_t outcome) {
    if ((outcome == 0)) {
        uint32_t sum = (balance + bond);
        if ((sum < balance)) {
            return 0xFFFFFFFF;
        } else {
            return sum;
        }
    } else {
        return balance;
    }
}

uint32_t required_bond(uint32_t outstanding, uint32_t min_bps) {
    uint64_t need = (((uint64_t)(outstanding)) * ((uint64_t)(min_bps)));
    return ((uint32_t)((need / ((uint64_t)(BOND_BPS_UNIT)))));
}

bool bond_covers(uint32_t bond, uint32_t outstanding, uint32_t min_bps) {
    return (bond >= required_bond(outstanding, min_bps));
}

uint32_t rung_min_bps(uint32_t min_bps, uint32_t gf_et) {
    if ((gf_et <= GFT16_ET)) {
        return min_bps;
    } else {
        return (min_bps + ((gf_et - GFT16_ET) * BOND_BPS_PER_TRIT));
    }
}

uint32_t required_bond_rung(uint32_t outstanding, uint32_t min_bps, uint32_t gf_et) {
    return required_bond(outstanding, rung_min_bps(min_bps, gf_et));
}

bool bond_covers_rung(uint32_t bond, uint32_t outstanding, uint32_t min_bps, uint32_t gf_et) {
    return (bond >= required_bond_rung(outstanding, min_bps, gf_et));
}

/* -------------------------------------------------------
   Tests
   ------------------------------------------------------- */

void test_post_is_guarded(void) {
    t27_assert((can_post(1000, 200) == true), "can lock within balance");
    t27_assert((can_post(1000, 2000) == false), "cannot over-post");
    t27_assert((balance_after_post(1000, 200) == 800), "valid post reduces balance");
    t27_assert((balance_after_post(1000, 2000) == 1000), "over-post is a no-op (no underflow)");
    t27_assert((locked_amount(1000, 200) == 200), "locks the requested amount");
    t27_assert((locked_amount(1000, 2000) == 0), "invalid post locks nothing");
}

void test_honest_round_trips_the_bond(void) {
    uint64_t after_post = balance_after_post(1000, 200);
    (void)after_post;
    uint64_t bond = locked_amount(1000, 200);
    (void)bond;
    t27_assert((bond_state_after(0) == ST_RELEASED), "honest -> released");
    t27_assert((balance_after_resolve(after_post, bond, 0) == 1000), "bond returns; balance whole");
}

void test_honest_release_saturates(void) {
    t27_assert((balance_after_resolve(500, 200, 0) == 700), "normal release exact (regression)");
    t27_assert((balance_after_resolve(0xFFFFFFF0, 200, 0) == 0xFFFFFFFF), "release that would overflow saturates to u32 max, not wrap to ~184");
    t27_assert((balance_after_resolve(0xFFFFFFF0, 200, 1) == 0xFFFFFFF0), "slash never adds -> no overflow, balance unchanged");
}

void test_slash_forfeits_the_bond(void) {
    uint64_t after_post = balance_after_post(1000, 200);
    (void)after_post;
    uint64_t bond = locked_amount(1000, 200);
    (void)bond;
    t27_assert((bond_state_after(1) == ST_SLASHED), "slash -> slashed");
    t27_assert((balance_after_resolve(after_post, bond, 1) == 800), "bond forfeited; balance stays reduced");
}

void test_non_terminal_outcomes_keep_the_bond_locked(void) {
    t27_assert((bond_state_after(2) == ST_LOCKED), "MALFORMED -> bond stays locked, not slashed");
    t27_assert((bond_state_after(3) == ST_LOCKED), "STALE -> bond stays locked");
    t27_assert((bond_state_after(4) == ST_LOCKED), "FAMILY_MISMATCH -> bond stays locked");
    t27_assert((bond_state_after(5) == ST_LOCKED), "INDETERMINATE -> bond stays locked");
    t27_assert((bond_state_after(0) == ST_RELEASED), "HONEST -> released");
    t27_assert((bond_state_after(1) == ST_SLASHED), "SLASH -> slashed");
    uint64_t after_post = balance_after_post(1000, 200);
    (void)after_post;
    t27_assert((balance_after_resolve(after_post, 200, 2) == 800), "malformed: bond neither returned nor added to balance");
    t27_assert((balance_after_resolve(after_post, 200, 5) == 800), "indeterminate: bond stays escrowed");
}

void test_required_bond_scales(void) {
    t27_assert((required_bond(1000, 2000) == 200), "20% of 1000 outstanding = 200");
    t27_assert((required_bond(1000, BOND_BPS_UNIT) == 1000), "100% ratio -> bond must equal outstanding");
    t27_assert((required_bond(1000, 15000) == 1500), "150% ratio -> over-collateralized");
    t27_assert((required_bond(0, 15000) == 0), "no outstanding risk needs no bond");
    t27_assert((required_bond(1000000, 20000) == 2000000), "1e6 * 20000 / 10000 = 2e6 (u64, no u32 overflow)");
}

void test_required_bond_scales_with_rung(void) {
    t27_assert((rung_min_bps(2000, 4) == 2000), "GF-T16 (Et4) uses the base ratio");
    t27_assert((rung_min_bps(2000, 6) == 3000), "GF-T32 (Et6) +2 trits -> +10%");
    t27_assert((rung_min_bps(2000, 9) == 4500), "GF-T64 (Et9) +5 trits -> +25%");
    t27_assert((rung_min_bps(2000, 14) == 7000), "GF-T128 (Et14) +10 trits -> +50%");
    t27_assert((rung_min_bps(2000, 3) == 2000), "sub-flagship GF-T8 uses the base (never shrinks)");
    t27_assert((required_bond_rung(1000, 2000, 4) == 200), "GF-T16 needs 200");
    t27_assert((required_bond_rung(1000, 2000, 9) == 450), "GF-T64 needs 450 -- more collateral");
    t27_assert((required_bond_rung(1000, 2000, 9) > required_bond_rung(1000, 2000, 4)), "wider rung -> bigger bond");
    t27_assert((bond_covers_rung(450, 1000, 2000, 9) == true), "450 covers GF-T64");
    t27_assert((bond_covers_rung(200, 1000, 2000, 9) == false), "a GF-T16-sized bond underfunds GF-T64");
}

void test_bond_coverage_gate(void) {
    t27_assert((bond_covers(200, 1000, 2000) == true), "200 covers 20% of 1000");
    t27_assert((bond_covers(199, 1000, 2000) == false), "199 is one short of the 200 required");
    t27_assert((bond_covers(1, 1000, 2000) == false), "a nominal bond does NOT cover 1000 of outstanding risk");
    t27_assert((bond_covers(1000, 1000, BOND_BPS_UNIT) == true), "a full 100% bond covers");
    t27_assert((bond_covers(0, 0, 20000) == true), "a fresh node with no outstanding risk is covered by a zero bond");
}


