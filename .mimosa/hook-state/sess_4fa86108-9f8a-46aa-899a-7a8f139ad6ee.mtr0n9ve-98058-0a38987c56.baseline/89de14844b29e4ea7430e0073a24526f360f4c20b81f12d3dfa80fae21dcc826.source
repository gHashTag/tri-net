void test_create_task_resource_basic(void) {
    uint64_t task = create_task_resource(30, 64, PRIORITY_HIGH, 5);
    (void)task;
    t27_assert((get_cpu_req(task) == 30), "CPU requirement");
    t27_assert((get_mem_req(task) == 64), "memory requirement");
    t27_assert((get_priority(task) == PRIORITY_HIGH), "priority");
    t27_assert((get_task_id(task) == 5), "task ID");
}

void test_create_system_state_basic(void) {
    uint64_t state = create_system_state(60, 128, 4, 100);
    (void)state;
    t27_assert((get_used_cpu(state) == 60), "used CPU");
    t27_assert((get_used_mem(state) == 128), "used memory");
    t27_assert((get_active_tasks(state) == 4), "active tasks");
    t27_assert((get_sched_tick(state) == 100), "scheduler tick");
}

void test_can_admit_task_true(void) {
    uint64_t state = create_system_state(30, 100, 2, 0);
    (void)state;
    uint64_t task = create_task_resource(20, 50, PRIORITY_MEDIUM, 5);
    (void)task;
    t27_assert((can_admit_task(state, task) == true), "can admit");
}

void test_can_admit_task_false_cpu(void) {
    uint64_t state = create_system_state(95, 100, 2, 0);
    (void)state;
    uint64_t task = create_task_resource(20, 50, PRIORITY_MEDIUM, 5);
    (void)task;
    t27_assert((can_admit_task(state, task) == false), "insufficient CPU");
}

void test_can_admit_task_false_memory(void) {
    uint64_t state = create_system_state(30, 230, 2, 0);
    (void)state;
    uint64_t task = create_task_resource(20, 50, PRIORITY_MEDIUM, 5);
    (void)task;
    t27_assert((can_admit_task(state, task) == false), "insufficient memory");
}

void test_has_cpu_capacity_true(void) {
    uint64_t state = create_system_state(30, 100, 2, 0);
    (void)state;
    t27_assert((has_cpu_capacity(state, 50) == true), "has CPU capacity");
}

void test_has_cpu_capacity_false(void) {
    uint64_t state = create_system_state(80, 100, 2, 0);
    (void)state;
    t27_assert((has_cpu_capacity(state, 50) == false), "no CPU capacity");
}

void test_allocate_resources_works(void) {
    uint64_t state = create_system_state(30, 100, 2, 0);
    (void)state;
    uint64_t task = create_task_resource(20, 50, PRIORITY_MEDIUM, 5);
    (void)task;
    uint64_t new_state = allocate_resources(state, task);
    (void)new_state;
    t27_assert((get_used_cpu(new_state) == 50), "CPU allocated");
    t27_assert((get_used_mem(new_state) == 150), "memory allocated");
    t27_assert((get_active_tasks(new_state) == 3), "task count increased");
}

void test_release_resources_works(void) {
    uint64_t state = create_system_state(60, 150, 4, 0);
    (void)state;
    uint64_t task = create_task_resource(20, 50, PRIORITY_MEDIUM, 5);
    (void)task;
    uint64_t new_state = release_resources(state, task);
    (void)new_state;
    t27_assert((get_used_cpu(new_state) == 40), "CPU released");
    t27_assert((get_used_mem(new_state) == 100), "memory released");
    t27_assert((get_active_tasks(new_state) == 3), "task count decreased");
}

void test_find_admittable_task_high_priority(void) {
    uint64_t state = create_system_state(30, 100, 2, 0);
    (void)state;
    t27_arr_uint32_t_8 task_array = create_task_array(create_task_resource(20, 30, PRIORITY_LOW, 1), create_task_resource(15, 40, PRIORITY_HIGH, 2), create_task_resource(25, 35, PRIORITY_MEDIUM, 3), 0, 0, 0, 0, 0);
    (void)task_array;
    t27_assert((find_admittable_task(state, task_array) == 1), "high priority task");
}

void test_calculate_cpu_utilization(void) {
    uint64_t state = create_system_state(60, 128, 4, 0);
    (void)state;
    t27_assert((calculate_cpu_utilization(state) == 60), "60% CPU utilization");
}

void test_calculate_memory_utilization(void) {
    uint64_t state = create_system_state(60, 128, 4, 0);
    (void)state;
    t27_assert((calculate_memory_utilization(state) == 50), "50% memory utilization");
}

void test_is_overloaded_true(void) {
    uint64_t state = create_system_state(95, 128, 4, 0);
    (void)state;
    t27_assert((is_overloaded(state) == true), "system overloaded");
