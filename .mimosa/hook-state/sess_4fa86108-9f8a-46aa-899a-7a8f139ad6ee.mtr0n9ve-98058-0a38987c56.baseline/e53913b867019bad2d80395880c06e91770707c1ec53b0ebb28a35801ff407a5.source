}

uint32_t elapsed(uint32_t t_start, uint32_t t_end) {
    return (t_end - t_start);
}

uint32_t twr_tof(uint32_t t1, uint32_t t2, uint32_t t3, uint32_t t4) {
    return (((t4 - t1) - (t3 - t2)) >> 1);
}

