void test_tick_advances(void) {
    uint64_t c1 = tick(0);
    (void)c1;
    uint64_t c2 = tick(c1);
    (void)c2;
    t27_assert((c2 == 2), "two ticks");
}

void test_capture_latches(void) {
    uint64_t c = capture(123456);
    (void)c;
    t27_assert((c == 123456), "latched value");
}

void test_elapsed_same_clock(void) {
